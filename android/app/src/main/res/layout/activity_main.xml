<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_bg"
        app:title="日本素材采集"
        app:titleTextColor="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/panel_collect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/dot_gray" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="空闲"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="尚未运行 · 已发送 0"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextLabel"
                        android:text="控制台" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_run_once"
                            style="@style/ButtonPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="立即采集一轮" />

                        <Button
                            android:id="@+id/btn_loop_start"
                            style="@style/ButtonOutline"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="开始循环" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_loop_stop"
                        style="@style/ButtonOutline"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:text="停止循环" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextLabel"
                        android:text="运行日志" />

                    <TextView
                        android:id="@+id/log_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:maxHeight="380dp"
                        android:padding="10dp"
                        android:background="@drawable/input_bg"
                        android:textColor="@color/text_primary"
                        android:textColorLink="@color/accent"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/panel_gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/gallery_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已采集 0 张"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_refresh_gallery"
                    style="@style/ButtonOutline"
                    android:layout_height="40dp"
                    android:text="刷新" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gallery_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/panel_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextLabel"
                        android:text="关键词（每行一个，可增删）" />

                    <EditText
                        android:id="@+id/cfg_keywords"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:minLines="8"
                        android:hint="每一行一个关键词" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextLabel"
                        android:text="Telegram 推送" />

                    <EditText
                        android:id="@+id/cfg_token"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:hint="bot_token"
                        android:inputType="text"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/cfg_chat"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:hint="chat_id"
                        android:inputType="phone"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBase"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextLabel"
                        android:text="采集参数" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/cfg_interval"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="间隔分"
                            android:inputType="number"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/cfg_per_keyword"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="每词张数"
                            android:inputType="number"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/cfg_pages"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="页数"
                            android:inputType="number"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/cfg_per_round"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="每轮词数"
                            android:inputType="number"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/cfg_max_mb"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="大小MB"
                            android:inputType="number"
                            android:singleLine="true" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/cfg_album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="组图发送（相册模式）"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save"
                    style="@style/ButtonPrimary"
                    android:text="保存配置" />

                <Button
                    android:id="@+id/btn_clear_history"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="清空历史（重新采集相同的图）" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:itemIconTint="@color/text_secondary"
        app:itemTextColor="@color/text_secondary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>